                  },
                  "rating": {
                    "type": "number",
                    "example": 4.5
                  },
                  "sku": {
                    "type": "string",
                    "example": "RUN-SHOE-001"
                  },
                  "stock": {
                    "type": "integer",
                    "example": 100
