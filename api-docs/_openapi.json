{
  "openapi": "3.0.0",
  "info": {
    "title": "E-commerce API",
    "description": "API Documentation",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "paths": {
    "/auth/register": {
      "post": {
        "summary": "User login",
        "tags": [
          "Auth"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterUserReq"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Register successful"
          },
          "401": {
            "description": "Invalid credentials"
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "summary": "User login",
        "tags": [
          "Auth"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginUserReq"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login successful"
          },
          "401": {
            "description": "Invalid credentials"
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "summary": "User Logout",
        "tags": [
          "Auth"
        ],
        "responses": {
          "200": {
            "description": "Logout successful"
          },
          "401": {
            "description": "Not logged in"
          }
        }
      }
    },
    "/auth/google": {
      "get": {
        "summary": "User login",
        "tags": [
          "Auth"
        ],
        "responses": {
          "200": {
            "description": "Logout successful"
          },
          "401": {
            "description": "Not logged in"
          }
        }
      }
    },
    "/user/update-user": {
      "put": {
        "summary": "User update",
        "tags": [
          "User"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateUserReq"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "update successful"
          },
          "401": {
            "description": "Invalid values"
          }
        }
      }
    },
    "/user/delete-user": {
      "delete": {
        "summary": "User Delete",
        "tags": [
          "User"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DeleteUserReq"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "delete successful"
          },
          "401": {
            "description": "Invalid values"
          }
        }
      }
    },
    "/variant/create-variant-property": {
      "post": {
        "summary": "Create variant property",
        "tags": [
          "Variant"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateVariantPropertyReq"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Create variant property successful"
          },
          "401": {
            "description": "Invalid values"
          }
        }
      }
    },
    "/variant/update-variant-property": {
      "put": {
        "summary": "variant properties update",
        "tags": [
          "Variant"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateVariantPropertyReq"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "update successful"
          },
          "401": {
            "description": "Invalid values"
          }
        }
      }
    },
    "/variant/delete-variant-property": {
      "delete": {
        "summary": "Variant Property Delete",
        "tags": [
          "Variant"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DeleteVariantPropertyReq"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "delete successful"
          },
          "401": {
            "description": "Invalid values"
          }
        }
      }
    },
    "variant/get-all-variant-properties": {
      "get": {
        "summary": "Variant Property get All",
        "tags": [
          "Variant"
        ],
        "requestBody": null,
        "responses": {
          "200": {
            "description": "fetch successful",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UpdateVariantPropertyReq"
                }
              }
            }
          },
          "401": {
            "description": "Invalid values"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "RegisterUserReq": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "user@example.com"
          },
          "password": {
            "type": "string",
            "example": "Password123&"
          },
          "username": {
            "type": "string",
            "example": "Johndoe12"
          },
          "phone_number": {
            "type": "number",
            "example": 1234567890
          }
        },
        "required": [
          "email",
          "password",
          "username",
          "phone_number"
        ]
      },
      "LoginUserReq": {
        "type": "object",
        "properties": {
          "identifier": {
            "type": "string",
            "example": "user@example.com"
          },
          "password": {
            "type": "string",
            "example": "Password123&"
          }
        },
        "required": [
          "identifier",
          "password"
        ]
      },
      "UpdateUserReq": {
        "type": "object",
        "properties": {
          "user_id": {
            "type": "string",
            "format": "uuid",
            "example": "123e4567-e89b-12d3-a456-426614174000"
          },
          "email": {
            "type": "string",
            "example": "user@example.com"
          },
          "password": {
            "type": "string",
            "example": "Password123&"
          },
          "username": {
            "type": "string",
            "example": "Johndoe12"
          },
          "phone_number": {
            "type": "number",
            "example": 1234567890
          },
          "wishlist_name": {
            "type": "string",
            "example": "wishlist_name"
          }
        },
        "required": [
          "id",
          "email",
          "password",
          "username",
          "phone_number",
          "wishlist_name"
        ]
      },
      "DeleteUserReq": {
        "type": "object",
        "properties": {
          "user_id": {
            "type": "string",
            "format": "uuid",
            "example": "123e4567-e89b-12d3-a456-426614174000"
          }
        },
        "required": [
          "user_id"
        ]
      },
      "CreateVariantPropertyReq": {
        "type": "object",
        "properties": {
          "property_name": {
            "type": "string",
            "example": "color"
          }
        },
        "required": [
          "property_name"
        ]
      },
      "UpdateVariantPropertyReq": {
        "type": "object",
        "properties": {
          "variantProperty_id": {
            "type": "string",
            "format": "uuid",
            "example": "123e4567-e89b-12d3-a456-426614174000"
          },
          "property_name": {
            "type": "string",
            "example": "size"
          }
        },
        "required": [
          "variantProperty_id",
          "property_name"
        ]
      },
      "DeleteVariantPropertyReq": {
        "type": "object",
        "properties": {
          "variantProperty_id": {
            "type": "string",
            "format": "uuid",
            "example": "123e4567-e89b-12d3-a456-426614174000"
          }
        },
        "required": [
          "variantProperty_id"
        ]
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
